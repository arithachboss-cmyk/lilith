{
  "name": "acs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ACS website rebuild. Demo mode until the Owner approves go-live.",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "tsx scripts/serve.ts --port 4173",
    "verify": "tsx scripts/verify.ts",
    "stamp": "tsx scripts/stamp.ts",
    "e2e": "node tests/e2e/run.mjs",
    "claims": "tsx scripts/claims.ts",
    "cwv": "node tests/e2e/cwv.mjs",
    "qa": "npm run typecheck && npm run build && npm test && npm run verify && npm run claims && npm run e2e && npm run cwv && npm run slice && tsx scripts/qa-summary.ts",
    "build:slice": "tsx scripts/build-slice.ts",
    "slice": "npm run build:slice && node tests/e2e/slice.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
