{
  "name": "middle-property",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:boundaries": "pnpm --filter @lilith/config test",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:workspace-boundaries && pnpm test:exports",
    "test:workspace-boundaries": "node packages/config/scripts/check-workspace-boundaries.mjs",
    "test:exports": "node packages/config/scripts/check-kernel-exports.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "eslint": "9.39.4",
    "prettier": "3.9.6"
  }
}
