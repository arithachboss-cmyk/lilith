{
  "name": "middle-property",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:boundaries": "pnpm --filter @lilith/config test",
    "test:core": "pnpm --filter @lilith/core test",
    "test:contracts": "pnpm --filter @lilith/contracts test",
    "contracts:openapi": "pnpm --filter @lilith/contracts openapi",
    "contracts:check": "pnpm --filter @lilith/contracts openapi:check && pnpm --filter @lilith/contracts openapi:lint",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @lilith/db migrate",
    "test:db": "pnpm --filter @lilith/db test && pnpm --filter @lilith/db test:integration",
    "test:skeleton": "pnpm --filter @lilith/core test:integration && pnpm --filter @lilith/web test && pnpm --filter @lilith/web test:integration",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "eslint": "9.39.4",
    "prettier": "3.9.6"
  }
}
